# Mainnet RPC used by fork tests (and later by the app). Must not be committed.
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
ZEROX_API_KEY=
# App (read by Vite from this file):
# RPC for reads + simulation. Must support eth_simulateV1 on mainnet (publicnode does).
VITE_RPC_URL=https://ethereum-rpc.publicnode.com
# Set to 1 with VITE_RPC_URL=http://127.0.0.1:8545 to use a local `pnpm fork` (chain 31337).
VITE_DEV_FORK=
